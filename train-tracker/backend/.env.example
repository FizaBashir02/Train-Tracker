# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/train-tracker?retryWrites=true&w=majority

# JWT Token Credentials (256-bit hash)
JWT_SECRET=supersecret_companion_key_2026_change_me_in_production
JWT_REFRESH_SECRET=supersecret_companion_refresh_key_2026_change_me_in_production

# Optional Redis Cache (For multi-node Socket.IO horizontal scaling)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Push Notification Settings
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
