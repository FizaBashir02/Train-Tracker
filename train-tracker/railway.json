{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "watchPatterns": ["backend/src/**"]
  },
  "deploy": {
    "startCommand": "node backend/dist/index.js",
    "restartOnFailure": true,
    "numReplicas": 1
  }
}
