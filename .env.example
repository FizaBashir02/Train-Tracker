# =========================================================================
# PAKISTAN RAILWAYS COMPANION - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Copy this file to '.env' and populate with your real production credentials.
# DO NOT commit the '.env' file containing your actual credentials to source control.

# -------------------------
# 1. PRIMARY DATABASE (MongoDB Atlas)
# -------------------------
# Replace with your actual MongoDB Atlas connection string.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/train-companion?retryWrites=true&w=majority
MONGO_URI=your_mongodb_atlas_connection_string

# -------------------------
# 2. EMAIL SERVICE (SMTP Nodemailer)
# -------------------------
# Hostname of your SMTP server (e.g. smtp.gmail.com, smtp.mailgun.org, or smtp.resend.com)
SMTP_HOST=your_smtp_host
# Port of your SMTP server (usually 587 for TLS, or 465 for SSL)
SMTP_PORT=587
# Set to 'true' if using SSL on port 465, or 'false' for TLS on other ports
SMTP_SECURE=false
# Username/Email address for SMTP authentication
SMTP_USER=your_smtp_user
# Password or App-specific Password for SMTP authentication
SMTP_PASS=your_smtp_pass
# Sender email address displayed to users
SMTP_FROM=noreply@yourdomain.com

# -------------------------
# 3. SECURITY & CRYPTOGRAPHY (JWT Tokens)
# -------------------------
# Long, random secrets for encoding authentication state tokens
JWT_SECRET=generate_a_long_random_jwt_access_secret_here
JWT_REFRESH_SECRET=generate_a_long_random_jwt_refresh_secret_here

# -------------------------
# 4. MOBILE MOBILE INTEGRATION (Google Maps & Firebase)
# -------------------------
# Real Google Maps API Key used for showing live tracking, routes, and stations in the Android app.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_from_cloud_console

# Path or base64 string of the service account credential JSON for Firebase Admin SDK (used to send FCM push messages)
FIREBASE_SERVICE_ACCOUNT_JSON=your_firebase_service_account_json_content

# -------------------------
# 5. SERVER RUNTIME SETTINGS
# -------------------------
# Port on which the production Express.js gateway will listen
PORT=5000
# Target public API URL consumed by the Android application (leave empty to fallback to default gateway)
API_URL=https://your-production-railway-app-url.railway.app/api/
